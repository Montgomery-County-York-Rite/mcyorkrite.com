source "https://rubygems.org"

# Ruby 3.3.x; the patch version is intentionally unpinned so CI can use
# the current 3.3 release. Local development version: .ruby-version
ruby "~> 3.3"

# Static site generator and production plugins.
gem "jekyll", "~> 4.3"
gem "jekyll-sitemap", "~> 1.4"

# Local preview server (Ruby 3+ no longer bundles webrick).
gem "webrick", "~> 1.8"

group :development do
  gem "rake", "~> 13.0"
end
